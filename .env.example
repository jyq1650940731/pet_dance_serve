ENV=development
DATABASE_URL=postgresql+psycopg://pet:pet@localhost:5432/pet_dance
REDIS_URL=redis://localhost:6379/0
QUEUE_MODE=arq
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./var/storage
STORAGE_PUBLIC_BASE=http://localhost:8080
SMS_PROVIDER=dev
SMS_DEV_CODE=246810
ADMIN_USERNAME=admin
ADMIN_PASSWORD=petdance-admin
APP_JWT_SECRET=dev-app-jwt-secret-change-me-32b
ADMIN_JWT_SECRET=dev-admin-jwt-secret-change-me-32
TERMS_VERSION=2026-10-28
PRIVACY_VERSION=2026-10-28
CORS_ORIGINS=http://localhost:5173

# 本机没有 PostgreSQL / Redis 时，可以改成：
# DATABASE_URL=sqlite+aiosqlite:///./var/pet_dance.db
# REDIS_URL=memory
# QUEUE_MODE=inline
# 生产环境改为 oss，并填写 OSS_*、ALIYUN_SMS_*，且 ENV=production。
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# OSS_BUCKET=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_CDN_BASE=
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=
